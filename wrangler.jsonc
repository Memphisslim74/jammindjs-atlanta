{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jammindjs-atlanta",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/wp-content/uploads/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jammindjs-atlanta"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
