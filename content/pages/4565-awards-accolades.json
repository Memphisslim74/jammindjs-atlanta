px\" /></a>\n\t\t\t</dt></dl><dl class='gallery-item'>\n\t\t\t<dt class='gallery-icon landscape'>\n\t\t\t\t<a href='https://www.jammindjs.net/wp-content/uploads/2020/04/2016-ww-5ea1225c81056.png'><img loading=\"lazy\" decoding=\"async\" width=\"150\" height=\"150\" src=\"https://www.jammindjs.net/wp-content/uploads/2020/04/2016-ww-5ea1225c81056-150x150.png\" class=\"attachment-thumbnail size-thumbnail\" alt=\"WeddingWire Couples&#039; Choice Awards 2016 for Georgia Wedding DJ Service.\" srcset=\"https://www.jammindjs.net/wp-content/uploads/2020/04/2016-ww-5ea1225c81056-150x150.png 150w, https://www.jammindjs.net/wp-content/uploads/2020/04/2016-ww-5ea1225c81056.png 225w\" sizes=\"auto, (max-width: 150px) 100vw, 150px\" /></a>\n\t\t\t</dt></dl><dl class='gallery-item'>\n\t\t\t<dt class='gallery-icon landscape'>\n\t\t\t\t<a href='https://www.jammindjs.net/wp-content/uploads/2020/04/2015-ww-5ea1225b7e466.png'><img loading=\"lazy\" decoding=\"async\" width=\"150\" height=\"150\" src=\"https://www.jammindjs.net/wp-content/uploads/2020/04/2015-ww-5ea1225b7e466-150x150.png\" class=\"attachment-thumbnail size-thumbnail\" alt=\"Weddingwire couples&#039; choice accolades 2015.\" srcset=\"https://www.jammindjs.net/wp-content/uploads/2020/04/2015-ww-5ea1225b7e466-150x150.png 150w, https://www.jammindjs.net/wp-content/uploads/2020/04/2015-ww-5ea1225b7e466.png 225w\" sizes=\"auto, (max-width: 150px) 100vw, 150px\" /></a>\n\t\t\t</dt></dl><dl class='gallery-item'>\n\t\t\t<dt class='gallery-icon landscape'>\n\t\t\t\t<a href='https://www.jammindjs.net/wp-content/uploads/2020/04/2013-ww-5ea1225a4823b.png'><img loading=\"lazy\" decoding=\"async\" width=\"150\" height=\"150\" src=\"https://www.jammindjs.net/wp-content/uploads/2020/04/2013-ww-5ea1225a4823b-150x150.png\" class=\"attachment-thumbnail size-thumbnail\" alt=\"Weddingwire bride&#039;s choice accolades 2013.\" srcset=\"https://www.jammindjs.net/wp-content/uploads/2020/04/2013-ww-5ea1225a4823b-150x150.png 150w, https://www.jammi