  "body_html": "\n\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2020/04/JAMMINJOHN-5ea1273725822-300x300.jpg\" alt=\"An elegant man in a tuxedo, holding a piece of historical paper.\" itemprop=\"image\" height=\"300\" width=\"300\" height=\"300\" width=\"300\" title=\"An elegant man in a tuxedo, holding a piece of historical paper.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t<h3><a href=\"https://www.jammindjs.net/john-murray\">John Murray</a></h3>\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2026/04/IMG_2703-300x300.jpeg\" alt=\"A bald man with a close-cropped beard and mustache, resembling many professional DJs, smiles at the camera against a softly blurred background.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A bald man with a close-cropped beard and mustache, resembling many professional DJs, smiles at the camera against a softly blurred background.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t<h3><a href=\"https://www.jammindjs.net/dj-john-b/\">DJ John B</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/dj-alex-lightning/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2026/01/6F38E5C3-7D97-4F54-A91D-2F4ECF986CF2-300x300.jpg\" alt=\"A person in a dark blue suit, light lavender shirt, and matching shoes stands smiling in a hallway with tiled flooring and framed wall décor.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A person in a dark blue suit, light lavender shirt, and matching shoes stands smiling in a hallway with tiled flooring and framed wall décor.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/dj-alex-lightning/\">DJ Alex &#8220;Lightning&#8221;</a></h3>\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2025/10/Joe-l-300x300.jpg\" alt=\"A man with glasses and tattoos sits on grass with his arms resting on his knees, wearing a light plaid shirt and dark pants. In the blurred background, tables and chairs hint at an event music setting provided by Professional DJs.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A man with glasses and tattoos sits on grass with his arms resting on his knees, wearing a light plaid shirt and dark pants. In the blurred background, tables and chairs hint at an event music setting provided by Professional DJs.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t<h3><a href=\"https://www.jammindjs.net/dj-joe-l/\">Joe L.</a></h3>\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2022/07/charles-300x300.jpg\" alt=\"A man in a suit and tie, smiling for the camera at a Georgia corporate event.\" itemprop=\"image\" height=\"300\" width=\"300\" height=\"300\" width=\"300\" title=\"A man in a suit and tie, smiling for the camera at a Georgia corporate event.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t<h3><a href=\"https://www.jammindjs.net/charles-judkins\">Chuck J</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/dj-highrize/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2025/04/Latoya-and-Larry-7-300x300.jpg\" alt=\"Man in a red jacket and bow tie, sitting and smiling, with glass windows in the background.\" itemprop=\"image\" height=\"300\" width=\"300\" height=\"300\" width=\"300\" title=\"Man in a red jacket and bow tie, sitting and smiling, with glass windows in the background.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/dj-highrize/\">DJ HighRize</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/vish-b\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2026/01/vish-thumb-2-300x300.jpg\" alt=\"A man in a blue suit, pink shirt, and patterned tie smiles while standing in front of black and white draped curtains, ready to entertain as one of the top professional DJs.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A man in a blue suit, pink shirt, and patterned tie smiles while standing in front of black and white draped curtains, ready to entertain as one of the top professional DJs.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/vish-b\">Vish B.</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/dj-danny-t/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2025/12/image0-300x300.jpeg\" alt=\"A man in formal attire with a pink rose boutonniere crouches in front of a wooden wall, looking at the camera.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A man in formal attire with a pink rose boutonniere crouches in front of a wooden wall, looking at the camera.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/dj-danny-t/\">DJ Danny T</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/dj-darryl-c/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2026/03/FK_301-300x300.jpg\" alt=\"A man with a beard and curly hair, wearing a blue suit and pink shirt, smiles with energy and creativity while seated in a modern office space.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A man with a beard and curly hair, wearing a blue suit and pink shirt, smiles with energy and creativity while seated in a modern office space.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/dj-darryl-c/\">DJ Darryl C</a></h3>\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2019/10/unnamed-5da892abb3392-300x300.jpg\" alt=\"A smiling black man in a suit and tie resembling Richard Cohen.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A smiling black man in a suit and tie resembling Richard Cohen.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t<h3><a href=\"https://www.jammindjs.net/richard-cohen/\">DJ Chiro</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/john-michaels/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2025/07/john-michael.jpg\" alt=\"A man with a beard and tattoos, wearing a red Nike polo shirt with a logo on the chest, stands against a plain white background, smiling at the camera-perfectly capturing the approachable vibe of professional DJs for event entertainment.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A man with a beard and tattoos, wearing a red Nike polo shirt with a logo on the chest, stands against a plain white background, smiling at the camera-perfectly capturing the approachable vibe of professional DJs for event entertainment.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/john-michaels/\">John Michaels</a></h3>\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2026/03/S.-Molina-Professional-Photo-2026-300x300.jpg\" alt=\"A person with long dark hair smiles at the camera, wearing a patterned top over a black shirt, in front of a pink gradient background-capturing the upbeat energy often seen in professional DJs.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A person with long dark hair smiles at the camera, wearing a patterned top over a black shirt, in front of a pink gradient background-capturing the upbeat energy often seen in professional DJs.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t<h3><a href=\"https://www.jammindjs.net/dj-stephanie-m/\">DJ Stephanie M</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/dj-os3/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2025/11/IMG_9638-300x300.jpg\" alt=\"A man in a green t-shirt with a white letter &quot;A&quot; sits on a wooden bench outdoors, looking to his left. Leafless trees and sunlight are visible in the background.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A man in a green t-shirt with a white letter &quot;A&quot; sits on a wooden bench outdoors, looking to his left. Leafless trees and sunlight are visible in the background.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/dj-os3/\">DJ OS3</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/our-professional-djs/michael-c/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2024/06/Michael-Headshot-300x300.jpg\" alt=\"A smiling person with long hair and a mustache, wearing a light-colored shirt, stands in front of a serene backdrop. The cheerful expression on their face radiates warmth and positivity.\" itemprop=\"image\" height=\"300\" width=\"300\" title=\"A smiling person with long hair and a mustache, wearing a light-colored shirt, stands in front of a serene backdrop. The cheerful expression on their face radiates warmth and positivity.\" onerror=\"this.style.display='none'\" loading=\"lazy\" />\n\t\t\t\t</a>\n\t<h3><a href=\"https://www.jammindjs.net/our-professional-djs/michael-c/\">Michael C</a></h3>\n\t\t\t\t<a href=\"https://www.jammindjs.net/tyler-s/\"  target=\"_blank\" rel=\"noopener\"  itemprop=\"url\">\n\t\t\t\t<img decoding=\"async\" src=\"https://www.jammindjs.net/wp-content/uploads/2025/01/IMG_0375-3